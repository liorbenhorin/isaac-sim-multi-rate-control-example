#usda 1.0
(
    defaultPrim = "World"
    startTimeCode = 0
    endTimeCode = 30000000000
    timeCodesPerSecond = 30
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    # Keep the drive train and lidars; exclude the stock cameras and IMU.
    def Xform "Carter" (
        prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.2/Isaac/Robots/NVIDIA/NovaCarter/nova_carter.usd@
        variants = {
            string Configuration = "No_Internals"
            string Physics = "physx"
            string ROS = "Enabled"
            string Sensors = "All_Sensors"
        }
    )
    {
        double3 xformOp:translate = (4, 0, 0)
        over "chassis_link"
        {
            custom string isaac:nameOverride = "chassis_link"
            double3 xformOp:translate = (0, 0, 0.025)
            over "sensors"
            {
                over "front_hawk" (active = false) {}
                over "left_hawk" (active = false) {}
                over "right_hawk" (active = false) {}
                over "back_hawk" (active = false) {}
                over "front_owl" (active = false) {}
                over "left_owl" (active = false) {}
                over "right_owl" (active = false) {}
                over "back_owl" (active = false) {}
                over "chassis_imu" (active = false) {}

                over "front_RPLidar"
                {
                    custom string isaac:namespace = "front_2d_lidar"
                    over "RPLidar_S2E"
                    {
                        custom string isaac:nameOverride = "front_2d_lidar"
                        float omni:sensor:tickRate = 10
                        uint omni:sensor:Core:scanRateBaseHz = 10
                        bool omni:sensor:Core:accumulateOutputs = true
                    }
                    over "ROS_TF" (active = false) {}
                    over "ROS_Lidar"
                    {
                        over "frameId"
                        {
                            custom string inputs:value = "front_2d_lidar"
                        }
                        over "LaserScanPublish"
                        {
                            custom string inputs:topicName = "scan"
                            custom bool inputs:fullScan = true
                        }
                    }
                }

                over "rear_RPLidar"
                {
                    custom string isaac:namespace = "rear_2d_lidar"
                    over "RPLidar_S2E"
                    {
                        custom string isaac:nameOverride = "rear_2d_lidar"
                        float omni:sensor:tickRate = 10
                        uint omni:sensor:Core:scanRateBaseHz = 10
                        bool omni:sensor:Core:accumulateOutputs = true
                    }
                    over "ROS_TF" (active = false) {}
                    over "ROS_Lidar"
                    {
                        over "frameId"
                        {
                            custom string inputs:value = "rear_2d_lidar"
                        }
                        over "LaserScanPublish"
                        {
                            custom string inputs:topicName = "scan"
                            custom bool inputs:fullScan = true
                        }
                    }
                }

                over "XT_32"
                {
                    custom string isaac:namespace = "front_3d_lidar"
                    over "PandarXT_32_10hz"
                    {
                        custom string isaac:nameOverride = "front_3d_lidar"
                        # Full 360-degree scans at 10 Hz, independent of the camera.
                        float omni:sensor:tickRate = 10
                        uint omni:sensor:Core:scanRateBaseHz = 10
                        bool omni:sensor:Core:accumulateOutputs = true
                    }
                    # The robot's TF graph publishes this sensor's transform.
                    over "ROS_TF" (active = false) {}
                    over "ROS_LidarRTX"
                    {
                        over "PointCloudPublish"
                        {
                            custom string inputs:topicName = "points"
                            custom string inputs:frameId = "front_3d_lidar"
                            custom bool inputs:fullScan = true
                        }
                    }
                }
            }

            # Fisheye chase camera: 1 m behind, 1.3 m above, looking forward/down by 30 degrees.
            def Camera "FrontCamera" (
                prepend apiSchemas = ["OmniSensorAPI", "OmniLensDistortionOpenCvFisheyeAPI"]
            )
            {
                custom string isaac:nameOverride = "chase_camera"
                float2 clippingRange = (0.05, 500)
                float focalLength = 24
                float horizontalAperture = 36
                float verticalAperture = 20.25
                # Ideal equidistant fisheye, approximately 159 degrees horizontal at 1280 x 720.
                token omni:lensdistortion:model = "opencvFisheye"
                int2 omni:lensdistortion:opencvFisheye:imageSize = (1280, 720)
                float omni:lensdistortion:opencvFisheye:cx = 640
                float omni:lensdistortion:opencvFisheye:cy = 360
                float omni:lensdistortion:opencvFisheye:fx = 460
                float omni:lensdistortion:opencvFisheye:fy = 460
                float omni:lensdistortion:opencvFisheye:k1 = 0
                float omni:lensdistortion:opencvFisheye:k2 = 0
                float omni:lensdistortion:opencvFisheye:k3 = 0
                float omni:lensdistortion:opencvFisheye:k4 = 0
                float omni:sensor:tickRate = 30
                matrix4d xformOp:transform = (
                    (0, -1, 0, 0),
                    (0.5, 0, 0.866025403784, 0),
                    (-0.866025403784, 0, 0.5, 0),
                    (-1, 0, 1.3, 1)
                )
                uniform token[] xformOpOrder = ["xformOp:transform"]
            }
        }

        # Reuse Carter's drive and odometry/TF graphs, targeting active sensors only.
        over "transform_tree_odometry"
        {
            over "ComputeTF_tf_tree_base_link_to_sensors"
            {
                custom rel inputs:parentPrim = </World/Carter/chassis_link>
                custom rel inputs:targetPrims = [
                    </World/Carter/chassis_link/sensors/XT_32/PandarXT_32_10hz>,
                    </World/Carter/chassis_link/sensors/front_RPLidar/RPLidar_S2E>,
                    </World/Carter/chassis_link/sensors/rear_RPLidar/RPLidar_S2E>,
                    </World/Carter/chassis_link/FrontCamera>,
                ]
            }

            def OmniGraphNode "ros2_publish_clock"
            {
                token node:type = "isaacsim.ros2.bridge.ROS2PublishClock"
                int node:typeVersion = 1
                custom uint64 inputs:context.connect = </World/Carter/transform_tree_odometry/ros2_context.outputs:context>
                custom uint inputs:execIn.connect = </World/Carter/transform_tree_odometry/on_playback_tick.outputs:tick>
                custom double inputs:timeStamp.connect = </World/Carter/transform_tree_odometry/isaac_read_simulation_time.outputs:simulationTime>
                custom string inputs:topicName = "clock"
            }
        }
        over "chassis_imu" (active = false) {}
        over "differential_drive"
        {
            over "ros2_subscribe_twist"
            {
                custom string inputs:topicName = "cmd_vel"
            }
        }
    }

    def Xform "Track" (
        prepend references = @track.usda@
    ) {}

    def DomeLight "Light"
    {
        float inputs:intensity = 1000
    }
}
