Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 24; 24; 28
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: Robot TF
      Enabled: true
      Show Axes: true
      Show Arrows: true
      Show Names: true
      Marker Scale: 0.5
      Frames:
        All Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: XT-32 Point Cloud
      Enabled: true
      Topic:
        Value: /front_3d_lidar/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Queue Size: 5
      Style: Points
      Size (Pixels): 3
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Autocompute Value Bounds: true
      Decay Time: 0
    - Class: rviz_default_plugins/LaserScan
      Name: Front 2D Scan
      Enabled: true
      Topic:
        Value: /front_2d_lidar/scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Queue Size: 5
      Style: Points
      Size (Pixels): 5
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 0; 255; 255
      Decay Time: 0
    - Class: rviz_default_plugins/LaserScan
      Name: Rear 2D Scan
      Enabled: true
      Topic:
        Value: /rear_2d_lidar/scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Queue Size: 5
      Style: Points
      Size (Pixels): 5
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 0; 255
      Decay Time: 0
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_link
      Distance: 20
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Width: 1280
  Height: 800
