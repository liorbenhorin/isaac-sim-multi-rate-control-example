#usda 1.0
(
    defaultPrim = "Carter"
    metersPerUnit = 1
    upAxis = "Z"
)

# Retain the shipped drive train; exclude the stock sensor suite at composition time.
def Xform "Carter" (
    prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.2/Isaac/Robots/NVIDIA/NovaCarter/nova_carter.usd@
    variants = {
        string Configuration = "No_Internals"
        string Physics = "physx"
        string ROS = "Disabled"
        string Sensors = "None"
    }
)
{
}
